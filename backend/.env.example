# Copy to .env and fill in. Never commit .env.

# Optional: enables Claude for open-ended questions (otherwise Wikipedia is used)
ANTHROPIC_API_KEY=
JARVIS_MODEL=claude-haiku-5-5
# Used for uploads, documents and long requests
JARVIS_AGENT_MODEL=claude-sonnet-5-5

# Optional: folder of .mp3 files for "play song <name>"
MUSIC_DIR=

# Optional: email sending (use a Gmail *app password*, not your real password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Optional: name used to sign emails
SENDER_NAME=
# Document search: auto (local MiniLM model, falls back to keywords when offline), default or hash
RAG_EMBEDDER=auto
